- listing = race_session_adapter&.listing_simple_mode || []
- if listing.empty?
  .alert.alert-info
    No laps recorded yet.
- else
  - listing.group_by { |e| e.has_key?('team') && e['team'].present? ? e['team'] : '—' }.sort_by { |team, _| team }.each do |team, entries|
    %h2= team
    .table-responsive
      %table.table.table-striped.table-condensed
        %thead
          %tr
            %th
              Participant
            %th
              Laps
            %th
              Miles
        - entries.each do |entry|
          %tbody
            %tr
              %td
                %strong
                  = entry['name']
              %td
                %strong
                  = entry['lap_count']
              %td
                %strong
                  = (entry['lap_count'] * ConfigValue.laps_to_miles_ratio).round(2)
    .alwaysbreak